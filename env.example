# Waltrail — переменные окружения

# Database (БД аудита: журнал, реестр источников, чекпоинты)
DATABASE_URL=postgresql://postgres:postgres@db1:5432/postgres

RUST_LOG=info

# Порт REST API (api): переопределяется без пересборки, по умолчанию 8000.
# ВНИМАНИЕ: compose.yaml держит фиксированный маппинг портов 8000:8000 и
# healthcheck, завязанный на порт 8000, — при смене API_PORT обнови compose
# API_PORT=8000

# Белый список origin CORS (api): origin через запятую, например
# https://audit.example,https://grafana.example. Не задана или пустая —
# слой разрешительный (allow_origin Any): браузерные читатели журнала
# работают из коробки. Задана — только перечисленные origin. Невалидный
# элемент (не происхождение scheme://host[:port] — с путём, query,
# userinfo) — ошибка старта api.
# API_CORS_ALLOWED_ORIGINS=

# Воркер CDC (worker-cdc) — только глобальные настройки; источники (строки
# подключения, служебные таблицы, префикс MESSAGE, размер батча) читаются
# из реестра источников и управляются через REST API (ADR-0005)
# Реконнект после обрыва соединения с источником: начальная пауза и верх экспоненты, мс
# CDC_RECONNECT_INITIAL_BACKOFF_MS=1000
# CDC_RECONNECT_MAX_BACKOFF_MS=30000
# Потолок буфера транзакции источника, строк журнала (дефолт 100000): транзакция
# клиента, превышающая потолок, не буферизуется целиком — попытка завершается
# ошибкой (статус источника `error` с текстом в реестре) и повторяется с backoff
# после реконнекта, вместо неограниченного роста памяти воркера (тикет #48);
# застрявший источник виден в реестре, остальные источники продолжают писать
# Следствие: пока застрявшая транзакция не уменьшена, слот источника не
# подтверждается — WAL у клиента удерживается и растёт (ретенция); уменьшите
# транзакцию клиента или поднимите потолок
# CDC_TX_BUFFER_MAX_ROWS=100000
