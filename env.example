# Waltrail — переменные окружения

# Database (БД аудита)
DATABASE_URL=postgresql://postgres:postgres@db1:5432/postgres

# Database (источник CDC — имитация БД клиента)
SOURCE_DATABASE_URL=postgresql://postgres:postgres@db-src:5432/postgres

RUST_LOG=info

# Воркер CDC (worker-cdc) — значения по умолчанию, задавать при необходимости
# Слот логической репликации и публикация на источнике
# CDC_SLOT=waltrail
# CDC_PUBLICATION=audit
# Префикс MESSAGE, интерпретируемого как канал контекста транзакции (ADR-0004)
# CDC_MESSAGE_PREFIX=_audit
# Служебные таблицы источника, не попадающие в журнал (через запятую)
# CDC_IGNORE_TABLES=public.alembic_version,public.schema_migrations,public._sqlx_migrations,public.django_migrations
# Размер чанка батчевой вставки строк в журнал
# CDC_BATCH_SIZE=500
# Реконнект после обрыва соединения: начальная пауза и верх экспоненты, мс
# CDC_RECONNECT_INITIAL_BACKOFF_MS=1000
# CDC_RECONNECT_MAX_BACKOFF_MS=30000
