@startuml
!include <logos/postgresql>
!include <logos/rust>

actor Client #black

package M_Audit {
  rectangle "<$rust>\n\nWorker CDC" as W
  rectangle "<$rust>\n\n   Api" as A
  database "<$postgresql>" as PG

  A <-right-> PG: Read
  W -> PG: Write
}

package M_Any {
  database "<$postgresql>" as PG_ANY
  rectangle "Api" as A_Any

  A_Any <-> PG_ANY: Write/Read
}

Client -> A

A_Any -> PG_ANY: pg_logical_emit_message\nв собственной транзакции (ADR-0002).
PG_ANY ->> W: Логическая репликация pgoutput\n(слот источника, ADR-0001).

@enduml
